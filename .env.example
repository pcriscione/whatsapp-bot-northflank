# Copiar a .env (nunca comitear el .env real). Ver ARCHITECTURE.md.

# Persistencia (Supabase). Si se omiten, se usa InMemoryLeadsRepository (solo para dev/test).
SUPABASE_URL=
SUPABASE_KEY=

# Tokens de autenticación para /restart, /qr y /export-contacts, uno por tenant.
TEST_RESTART_TOKEN=
LA_PRINCESA_RESTART_TOKEN=

# Allowlist del tenant "test": lista de teléfonos (sin @c.us, separados por coma) a
# los que el bot les responde. Cualquier otro remitente es ignorado. Nunca comitear
# números reales en tenants/*.json — solo acá, en el .env local del server de test.
TEST_ALLOWLIST=

# Allowlist temporal de "la-princesa" para el rollout gradual (canary): mientras esté
# seteada, el bot v2 en el número productivo SOLO responde a estos teléfonos. Vacía o
# sin definir = responde a todos (comportamiento normal de producción). Sacarla/vaciarla
# recién cuando el Paso 7 (corte controlado) esté validado.
LA_PRINCESA_ALLOWLIST=

# Webhook opcional de Google Sheets para el sorteo (por tenant).
LA_PRINCESA_SHEETS_WEBHOOK_URL=

# Opcional: pinnear versión de WhatsApp Web (ej. "2.x.x").
WWEBJS_WEB_VERSION=
